<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <RootNamespace>Tests.FatCat.WebFake</RootNamespace>
        <AssemblyName>Tests.FatCat.WebFake</AssemblyName>
        <LangVersion>12</LangVersion>
        <OutputType>Library</OutputType>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <CSharpier_Check>false</CSharpier_Check>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WebFake\WebFake.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FatCat.Toolkit" Version="1.0.356" />
        <PackageReference Include="FatCat.Toolkit.WebServer" Version="1.0.356" />
        <PackageReference Include="FakeItEasy" Version="9.0.1" />
        <PackageReference Include="FatCat.Fakes" Version="1.0.32" />
        <PackageReference Include="FatCat.Testing" Version="1.0.7" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
